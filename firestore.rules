rules_version = '2';

// Firestore security rules for the affiliates portal.
// These rules apply to affiliate-specific collections.
// The main Arena rules are deployed from the Arena repo and cover shared collections.
//
// IMPORTANT: These rules must be merged with the Arena rules before deployment,
// since both apps share the same Firebase project (greweco-bf4e0).

service cloud.firestore {
  match /databases/{database}/documents {

    // Affiliate profiles - separate collection to avoid overwriting Arena user docs
    // Server-only writes via Admin SDK
    match /affiliateProfiles/{odwcId} {
      allow read: if request.auth != null && request.auth.uid == odwcId;
      allow write: if false;
    }

    // Invite codes - affiliates can read to validate, server writes only
    match /invites/{inviteId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Click analytics - affiliates can read their own events
    // Server-only writes via Admin SDK
    match /clicks_analytics/{eventId} {
      allow read: if request.auth != null && 
        resource.data.affiliateId == request.auth.uid;
      allow write: if false;
    }

    // Commissions ledger - affiliates can read their own commissions
    // Server-only writes via Admin SDK
    // Requires composite index: affiliateId ASC, createdAt DESC
    match /commissions/{commissionId} {
      allow read: if request.auth != null && 
        resource.data.affiliateId == request.auth.uid;
      allow write: if false;
    }

    // Affiliate conversion outbox - server-only (used by Arena functions)
    match /affiliateConversions/{orderId} {
      allow read, write: if false;
    }
  }
}
